rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function activeUser() {
      return signedIn()
        && userDoc().exists()
        && userDoc().data.active != false
        && (!('status' in userDoc().data)
          || !['inactive', 'disabled', 'suspended', 'deleted']
            .hasAny([userDoc().data.status]));
    }

    function isAdmin() {
      return activeUser() && userDoc().data.role == 'admin';
    }

    function isTeacher() {
      return activeUser() && userDoc().data.role == 'teacher';
    }

    function isStudent() {
      return activeUser() && userDoc().data.role == 'student';
    }

    match /users/{uid} {
      allow read: if activeUser()
        && (request.auth.uid == uid || isAdmin());

      allow create, update, delete: if false;

      match /sessions/{sessionId} {
        allow read, write: if false;
      }
    }

    match /settings/{settingId} {
      allow read: if settingId == 'system';
      allow write: if false;
    }

    match /lessons/{lessonId} {
      allow read: if activeUser()
        && (
          isAdmin()
          || (isTeacher()
            && resource.data.teacherId == request.auth.uid)
          || (isStudent()
            && resource.data.studentId == request.auth.uid)
        );

      allow write: if false;

      match /{subcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    match /adminLogs/{logId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
