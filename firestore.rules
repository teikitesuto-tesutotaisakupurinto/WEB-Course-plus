rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function userRole() {
      return signedIn() && userDoc().exists()
        ? userDoc().data.role
        : null;
    }

    function isAdmin() {
      return signedIn() && userRole() == 'admin';
    }

    function isTeacher() {
      return signedIn() && userRole() == 'teacher';
    }

    function isStudent() {
      return signedIn() && userRole() == 'student';
    }

    function lessonDoc(lessonId) {
      return get(
        /databases/$(database)/documents/lessons/$(lessonId)
      );
    }

    function isLessonTeacher(lessonId) {
      return signedIn()
        && isTeacher()
        && lessonDoc(lessonId).exists()
        && lessonDoc(lessonId).data.teacherId == request.auth.uid;
    }

    function isLessonStudent(lessonId) {
      return signedIn()
        && isStudent()
        && lessonDoc(lessonId).exists()
        && lessonDoc(lessonId).data.studentId == request.auth.uid;
    }

    function isLessonParticipant(lessonId) {
      return isAdmin()
        || isLessonTeacher(lessonId)
        || isLessonStudent(lessonId);
    }

    // -----------------------------------------
    // ユーザー
    // -----------------------------------------

    match /users/{uid} {
      allow get: if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
          || (isTeacher() && resource.data.role == 'student')
        );

      allow list: if isAdmin()
        || (isTeacher() && resource.data.role == 'student');

      allow create: if isAdmin();

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'displayName',
              'phone',
              'introduction',
              'updatedAt'
            ])
        );

      allow delete: if isAdmin();
    }

    // -----------------------------------------
    // 授業
    // -----------------------------------------

    match /lessons/{lessonId} {
      allow get, list: if isAdmin()
        || (
          isTeacher()
          && resource.data.teacherId == request.auth.uid
        )
        || (
          isStudent()
          && resource.data.studentId == request.auth.uid
        );

      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.studentId is string
        && request.resource.data.title is string
        && request.resource.data.status == 'scheduled'
        && get(
          /databases/$(database)/documents/users/$(request.resource.data.studentId)
        ).data.role == 'student'
        && get(
          /databases/$(database)/documents/users/$(request.resource.data.studentId)
        ).data.status == 'active';

      allow update: if isAdmin()
        || (
          isTeacher()
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        );

      allow delete: if isAdmin();
    }

    // -----------------------------------------
    // 授業記録
    // -----------------------------------------

    match /lessonRecords/{recordId} {
      allow get, list: if isAdmin()
        || (
          isTeacher()
          && resource.data.teacherId == request.auth.uid
        )
        || (
          isStudent()
          && resource.data.studentId == request.auth.uid
        );

      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.lessonId is string
        && isLessonTeacher(request.resource.data.lessonId)
        && lessonDoc(request.resource.data.lessonId).data.studentId
          == request.resource.data.studentId;

      allow update, delete: if isAdmin();
    }

    // -----------------------------------------
    // システム設定
    // -----------------------------------------

    match /settings/{settingId} {
      allow get: if signedIn()
        && (
          settingId == 'system'
          || isAdmin()
        );

      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // -----------------------------------------
    // 授業画面へのリアルタイム書き込み
    //
    // lessonBoards/{lessonId}/strokes/{strokeId}
    // -----------------------------------------

    match /lessonBoards/{lessonId}/strokes/{strokeId} {

      allow get, list: if isLessonParticipant(lessonId);

      allow create: if isLessonParticipant(lessonId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.points is list
        && request.resource.data.points.size() <= 1000
        && request.resource.data.color is string
        && request.resource.data.width is number
        && request.resource.data.mode in ['pen', 'erase'];

      allow update: if isLessonParticipant(lessonId)
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.points is list
        && request.resource.data.points.size() <= 1000;

      allow delete: if isLessonParticipant(lessonId);
    }

    // -----------------------------------------
    // 授業チャット
    //
    // lessonMessages/{lessonId}/messages/{messageId}
    // -----------------------------------------

    match /lessonMessages/{lessonId}/messages/{messageId} {

      allow get, list: if isLessonParticipant(lessonId);

      allow create: if isLessonParticipant(lessonId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;

      allow update, delete: if false;
    }

    // -----------------------------------------
    // その他のコレクションは拒否
    // -----------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
