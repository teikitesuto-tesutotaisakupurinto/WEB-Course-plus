rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserProfile() {
      return signedIn()
        && exists(userPath(request.auth.uid));
    }

    function myProfile() {
      return get(userPath(request.auth.uid)).data;
    }

    function activeUser() {
      return hasUserProfile()
        && myProfile().active != false
        && (
          !('status' in myProfile())
          || !(myProfile().status in [
            'inactive',
            'disabled',
            'suspended',
            'deleted'
          ])
        );
    }

    function isAdmin() {
      return activeUser()
        && myProfile().role == 'admin';
    }

    function isTeacher() {
      return activeUser()
        && myProfile().role == 'teacher';
    }

    function isStudent() {
      return activeUser()
        && myProfile().role == 'student';
    }

    function lessonExists(lessonId) {
      return exists(
        /databases/$(database)/documents/lessons/$(lessonId)
      );
    }

    function lessonData(lessonId) {
      return get(
        /databases/$(database)/documents/lessons/$(lessonId)
      ).data;
    }

    function isLessonParticipant(lessonId) {
      return activeUser()
        && lessonExists(lessonId)
        && (
          (
            isTeacher()
            && lessonData(lessonId).teacherId == request.auth.uid
          )
          ||
          (
            isStudent()
            && lessonData(lessonId).studentId == request.auth.uid
          )
        );
    }

    function validText(value, maxLength) {
      return value is string
        && value.size() <= maxLength;
    }

    /* 利用者 */

    match /users/{uid} {

      allow get: if signedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || (
          isStudent()
          && resource.data.role == 'teacher'
        )
      );

      allow list: if isAdmin()
        || (
          isTeacher()
          && resource.data.role == 'student'
        );

      allow create, update, delete: if false;

      match /sessions/{sessionId} {
        allow read, write: if false;
      }
    }

    /* システム設定 */

    match /settings/{settingId} {
      allow get: if signedIn()
        && settingId == 'system';

      allow list, create, update, delete: if false;
    }

    /* 授業 */

    match /lessons/{lessonId} {

      allow get, list: if activeUser() && (
        isAdmin()
        || (
          isTeacher()
          && resource.data.teacherId == request.auth.uid
        )
        || (
          isStudent()
          && resource.data.studentId == request.auth.uid
        )
      );

      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.studentId is string
        && exists(userPath(request.resource.data.studentId))
        && get(userPath(request.resource.data.studentId)).data.role == 'student'
        && request.resource.data.status == 'scheduled'
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.endAt > request.resource.data.startAt;

      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.studentId == resource.data.studentId;

      allow delete: if isTeacher()
        && resource.data.teacherId == request.auth.uid;
    }

    /* 授業記録 */

    match /lessonRecords/{recordId} {

      allow get, list: if activeUser() && (
        isAdmin()
        || (
          isTeacher()
          && resource.data.teacherId == request.auth.uid
        )
        || (
          isStudent()
          && resource.data.studentId == request.auth.uid
        )
      );

      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.studentId is string
        && request.resource.data.lessonId is string
        && lessonExists(request.resource.data.lessonId)
        && lessonData(request.resource.data.lessonId).teacherId == request.auth.uid
        && lessonData(request.resource.data.lessonId).studentId == request.resource.data.studentId;

      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.studentId == resource.data.studentId;

      allow delete: if isTeacher()
        && resource.data.teacherId == request.auth.uid;
    }

    /* 授業ホワイトボード */

    match /lessonBoards/{lessonId}/strokes/{strokeId} {

      allow read: if isLessonParticipant(lessonId);

      allow create: if isLessonParticipant(lessonId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.mode in ['pen', 'eraser']
        && request.resource.data.points is list
        && request.resource.data.points.size() <= 5000;

      allow delete: if isLessonParticipant(lessonId);

      allow update: if false;
    }

    /* 授業チャット */

    match /lessonMessages/{lessonId}/messages/{messageId} {

      allow read: if isLessonParticipant(lessonId);

      allow create: if isLessonParticipant(lessonId)
        && request.resource.data.senderId == request.auth.uid
        && validText(request.resource.data.senderName, 100)
        && validText(request.resource.data.text, 2000);

      allow update, delete: if false;
    }

    /* 管理ログ */

    match /adminLogs/{logId} {
      allow read, write: if false;
    }

    /* セキュリティイベント */

    match /securityEvents/{eventId} {
      allow read, write: if false;
    }

    /* その他はすべて拒否 */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
