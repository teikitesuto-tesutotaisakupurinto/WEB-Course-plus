
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function activeUser() {
      return signedIn()
        && userDoc().exists()
        && userDoc().data.active != false
        && (
          !('status' in userDoc().data)
          || (
            userDoc().data.status != 'inactive'
            && userDoc().data.status != 'disabled'
            && userDoc().data.status != 'suspended'
            && userDoc().data.status != 'deleted'
          )
        );
    }

    function isAdmin() {
      return activeUser()
        && userDoc().data.role == 'admin';
    }

    function isTeacher() {
      return activeUser()
        && userDoc().data.role == 'teacher';
    }

    function isStudent() {
      return activeUser()
        && userDoc().data.role == 'student';
    }

    /* 利用者情報 */
    match /users/{uid} {

      // 自分のプロフィール取得はログイン済みなら許可
      allow get: if signedIn()
        && (
          request.auth.uid == uid
          || isAdmin()
        );

      // 利用者一覧は管理者だけ
      allow list: if isAdmin();

      // 利用者情報の変更はサーバー側からのみ
      allow create, update, delete: if false;

      match /sessions/{sessionId} {
        allow read, write: if false;
      }
    }

    /* システム設定 */
    match /settings/{settingId} {
      allow get: if settingId == 'system';
      allow list: if false;
      allow write: if false;
    }

    /* 授業 */
    match /lessons/{lessonId} {

      allow get, list: if activeUser()
        && (
          isAdmin()
          || (
            isTeacher()
            && resource.data.teacherId == request.auth.uid
          )
          || (
            isStudent()
            && resource.data.studentId == request.auth.uid
          )
        );

      // 授業の作成・変更はサーバー側からのみ
      allow create, update, delete: if false;

      match /{subcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    /* 管理者操作ログ */
    match /adminLogs/{logId} {
      allow read, write: if false;
    }

    /* その他 */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
